{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node-terminal",
			"request": "launch",
			"name": "Minecraft Client",
			"command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\gradlew.ps1 runClient",
			"cwd": "${workspaceFolder}",
			"env": {
				"JAVA_HOME": "C:\\Program Files\\Java\\jdk-25.0.2"
			}
		},
		{
			"type": "node-terminal",
			"request": "launch",
			"name": "Minecraft Server",
			"command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\gradlew.ps1 runServer",
			"cwd": "${workspaceFolder}",
			"env": {
				"JAVA_HOME": "C:\\Program Files\\Java\\jdk-25.0.2"
			}
		}
	]
}
