{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "runClient",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/gradlew.ps1",
				"runClient"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"JAVA_HOME": "C:\\Program Files\\Java\\jdk-25.0.2"
				}
			},
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			},
			"problemMatcher": []
		}
	]
}
